import Autoform.Generated.@MODULE@
import Autoform.Ledger
open Autoform.Core Autoform.Generated.@MODULE@

-- The verifiable-core number below is computed through `ResolveIndex`, not through the
-- per-call-site `Ctx.resolvable` scan. Before reporting it, re-derive it the slow way and
-- compare. A mismatch aborts: a ledger that silently reported the faster number would be
-- exactly the "silence reads as success" failure this project keeps catching.
#eval do
  if program.callClosureAgrees then
    IO.println s!"call-closure index agrees with Ctx.resolvable on @MODULE@ ({program.callClosed.length} functions)"
  else
    throw (IO.userError
      "@MODULE@: ResolveIndex disagrees with Ctx.resolvable — the ledger's verifiable core is NOT trustworthy")

#eval IO.println (program.ledger "@MODULE@")
#eval do
  let core := program.coreNames
  IO.println s!"\nverifiable core ({core.length}) — first 15:"
  for n in core.take 15 do IO.println s!"  {n}"

-- Machine-readable evidence for scripts/sacm.py, tagged with module and dialect.
#eval do
  IO.FS.writeFile "ledger-@MODULE@.json" (program.ledgerJson "@MODULE@").pretty
  IO.println "wrote ledger-@MODULE@.json"
